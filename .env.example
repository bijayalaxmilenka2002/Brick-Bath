PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace with your connection string from MongoDB Atlas:
# Cluster -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bricknbath?retryWrites=true&w=majority

# Local SQLite Fallback Database (used if MONGODB_URI is not set)
DB_PATH=./backend/data/bricknbath.sqlite

# Owner Security & Authentication (JWT)
OWNER_PASSWORD=your_secure_owner_password
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h

# Owner Email Notification Configuration
OWNER_EMAIL=lenkabijayalaxmi2002@gmail.com

# Gmail SMTP Configuration (for live email alerts on new leads)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lenkabijayalaxmi2002@gmail.com
SMTP_PASS=your_16_digit_google_app_password
